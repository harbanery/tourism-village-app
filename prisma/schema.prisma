generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Enums
// ============================================================

/** Status data (dipakai semua konten + akun). */
enum Status {
  ACTIVE
  NONACTIVE
}

/** Status pembayaran pesanan (Midtrans/simulator). */
enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELED
}

/** Role admin: master (semua), viewer (lihat saja), author (blog saja). */
enum AdminRole {
  MASTER
  VIEWER
  AUTHOR
}

/** Jenis kelamin pengguna. */
enum Gender {
  MALE
  FEMALE
}

// ============================================================
// Auth
// ============================================================

model AuthAdmin {
  id       Int       @id @default(autoincrement())
  email    String    @unique
  username String    @unique
  password String
  name     String?
  avatar   String?
  role     AdminRole @default(VIEWER)
  status   Status    @default(ACTIVE)
  blogs    Blog[]
  sessions AdminSession[]

  @@map("auth_admin")
}

model AuthUser {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  phone     String?  @map("no_tlp")
  password  String
  name      String
  gender    Gender?  @map("jenis_kelamin")
  birthDate DateTime? @map("tgl_lahir") @db.Date
  address   String?  @map("alamat")
  avatar    String?
  status    Status   @default(ACTIVE)
  orders       Order[]
  testimonials Testimonial[]
  sessions  UserSession[]

  @@map("auth_user")
}

model AdminSession {
  id        String   @id
  adminId   Int      @map("admin_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  admin AuthAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@map("admin_session")
}

model UserSession {
  id        String   @id
  userId    Int      @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_session")
}

/** Rate-limit login per IP (admin & web). */
model LoginAttempt {
  id            Int       @id @default(autoincrement())
  ipAddress     String    @unique @map("ip_address")
  scope         String    @default("admin") // admin | web
  attemptCount  Int       @default(0) @map("attempt_count")
  blockedUntil  DateTime? @map("blocked_until")
  lastAttemptAt DateTime  @default(now()) @map("last_attempt_at")

  @@map("login_attempt")
}

// ============================================================
// Content
// ============================================================

model Place {
  id       Int      @id @default(autoincrement())
  name     String   @map("tempat_name")
  status   Status   @default(ACTIVE)
  photo    String?  @map("photo_tempat")
  packages Package[]
  galleries Gallery[]
  videos    Video[]
  blogs    Blog[]

  @@map("wisata_tempat")
}

model Package {
  id         Int      @id @default(autoincrement())
  name       String   @map("paket_name")
  placeId    Int?     @map("tempat_id")
  facilities String[] @default([])
  price      Int      @map("harga")
  status     Status   @default(ACTIVE)
  place      Place?   @relation(fields: [placeId], references: [id], onDelete: SetNull)
  orderItems OrderItem[]

  @@map("wisata_paket")
}

model Gallery {
  id          Int     @id @default(autoincrement())
  title       String  @map("gambar_name")
  placeId     Int     @map("tempat_id")
  filename    String
  status      Status @default(ACTIVE)
  locked      String  @default("no") // yes | no (yes = dipakai sebagai cover tempat)
  place       Place   @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@map("galeri")
}

model Video {
  id        Int     @id @default(autoincrement())
  name      String  @map("video_name")
  placeId   Int     @map("tempat_id")
  linkCode  String  @map("link_code") // YouTube video id
  status    Status @default(ACTIVE)
  place     Place   @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@map("video")
}

model Blog {
  id            Int        @id @default(autoincrement())
  adminId       Int        @map("admin_id")
  placeId       Int?       @map("tempat_id")
  datetime      DateTime   @default(now())
  datetimeAfter DateTime?  @map("datetime_after")
  title         String
  filename      String // cover image (Cloudinary URL)
  para          String // gabungan paragraf pembuka + isi (rich text)
  status        Status     @default(ACTIVE)
  admin         AuthAdmin  @relation(fields: [adminId], references: [id], onDelete: Cascade)
  place         Place?     @relation(fields: [placeId], references: [id], onDelete: SetNull)

  @@map("blog")
}

model Sponsor {
  id          Int    @id @default(autoincrement())
  name        String @map("sponsor_name")
  description String? @map("deskripsi")
  filename    String // logo image (Cloudinary URL)
  status      Status @default(ACTIVE)

  @@map("sponsor")
}

model Testimonial {
  id       Int      @id @default(autoincrement())
  userId   Int      @map("user_id")
  date     DateTime @default(now()) @map("date_kom")
  comment  String   @map("komentar")
  rating   Int // 1..5
  status   Status   @default(NONACTIVE) // moderasi
  featured Boolean  @default(false) // utama (maksimal 3)
  note     String?  @map("keterangan")
  user     AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("komentar")
}

// ============================================================
// Orders
// ============================================================

model Order {
  id            Int           @id @default(autoincrement())
  userId        Int           @map("user_id")
  dateOrder     DateTime      @default(now()) @map("date_order")
  dateSchedule  DateTime      @map("date_schedule") @db.Date
  homestay      Boolean       @default(false)
  homestayTime  Int?          @map("homestay_time")
  totalPrice    Int           @map("total_harga")
  status        Status        @default(ACTIVE)
  paymentStatus PaymentStatus @default(PENDING) @map("payment_status")
  paymentMethod String?       @map("payment_method")
  snapToken     String?       @map("snap_token")
  /** URL halaman pembayaran hosted Midtrans (fallback bila snap.js diblokir). */
  snapRedirectUrl String?     @map("snap_redirect_url")
  paidAt        DateTime?     @map("paid_at")
  /** Batas waktu pembayaran (lewat dari ini → PENDING di-expire jadi CANCELED). */
  paymentExpiresAt DateTime?  @map("payment_expires_at")
  user          AuthUser      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items         OrderItem[]

  @@map("wisata_pesan")
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int     @map("pesan_id")
  packageId Int     @map("paket_id")
  quantity  Int
  price     Int // subtotal
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  package   Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@map("wisata_pesan_detail")
}
